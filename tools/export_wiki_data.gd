extends SceneTree
## Regenerates the data tables in docs/wiki/generated/ straight from the game's databases,
## so the player wiki never drifts from the code. Run after changing items, recipes, fish,
## crops, placeables or creatures:
##
##   godot --headless --path . -s tools/export_wiki_data.gd
##
## Every generated page starts with a "do not edit" banner; hand-written pages link to them.

const OUT := "res://docs/wiki/generated/"
const BANNER := "<!-- Generated by tools/export_wiki_data.gd. Do not edit by hand: re-run the tool. -->\n\n"

const CATEGORY_NAMES := ["Material", "Food", "Tool", "Equipment", "Blueprint", "Special"]
const RECIPE_CATS := ["Hand craft", "Workbench", "Cooking", "Smokehouse", "Saltery", "Brewing", "Forge"]
const RARITY := ["Common", "Uncommon", "Rare", "Legendary"]
const HABITAT := ["Shallows", "Tidal pool", "Open water", "Cliff surge", "Deep trench"]
const TIDE := ["Any tide", "Low tide only", "High tide only", "Turning tide"]
const WEATHER := ["Any weather", "Fair only", "Storms only", "Fog only"]
const TIME := ["Any time", "Day only", "Night only"]
const SOIL := ["Sweet soil (fresh water)", "Brackish tidal mud", "Any damp ground"]
const TACKLE := ["", "Whittled Rod", "Ocean Caster", "Brass Reel", "Abyssal Rod"]
const PROFESSIONS := ["Fisher", "Farmer", "Carpenter", "Smoker & Chef", "Lamplighter", "Trader"]


func _init() -> void:
	VoxelWorld.push_palette()
	ItemDB.init_db()
	RecipeDB.init_db()
	FishDB.init_db()
	CropDB.init_db()
	Placeables.register_builtin()
	DirAccess.make_dir_recursive_absolute(OUT)
	_write("items.md", _items())
	_write("recipes.md", _recipes())
	_write("fish.md", _fish())
	_write("crops.md", _crops())
	_write("placeables.md", _placeables())
	_write("creatures.md", _creatures())
	print("[wiki] tables written to ", ProjectSettings.globalize_path(OUT))
	quit()


func _write(file: String, body: String) -> void:
	var f := FileAccess.open(OUT + file, FileAccess.WRITE)
	f.store_string(BANNER + body)
	f.close()


static func _cell(s: Variant) -> String:
	return String(str(s)).replace("|", "/").replace("\n", " ")


static func _table(head: Array, rows: Array) -> String:
	var out := "| " + " | ".join(PackedStringArray(head)) + " |\n"
	out += "|" + "---|".repeat(head.size()) + "\n"
	for r: Array in rows:
		var cells := PackedStringArray()
		for c in r:
			cells.append(_cell(c))
		out += "| " + " | ".join(cells) + " |\n"
	return out + "\n"


static func _item_name(id: StringName) -> String:
	var d := ItemDB.get_item(id)
	return d.name if d != null else String(id)


# ---------------------------------------------------------------- items

func _items() -> String:
	var by_cat := {}
	for d: ItemDef in ItemDB.get_all_items():
		if not by_cat.has(d.category):
			by_cat[d.category] = []
		by_cat[d.category].append(d)
	var out := "# Items\n\nEvery item in the game, by category. Value is the base merchant price in Brass Guilders.\n\n"
	for cat in range(CATEGORY_NAMES.size()):
		if not by_cat.has(cat):
			continue
		var list: Array = by_cat[cat]
		list.sort_custom(func(a: ItemDef, b: ItemDef) -> bool: return a.name < b.name)
		var rows := []
		for d: ItemDef in list:
			rows.append([d.name, "`%s`" % d.id, d.max_stack, d.value_brass, ", ".join(d.tags)])
		out += "## %s (%d)\n\n" % [CATEGORY_NAMES[cat], list.size()]
		out += _table(["Item", "Id", "Stack", "Value", "Tags"], rows)
	return out


# ---------------------------------------------------------------- recipes

## recipe id -> how it is unlocked (plain words).
func _unlock_sources() -> Dictionary:
	var src := {}
	for item: StringName in RecipeBook.DISCOVERY:
		for r: StringName in RecipeBook.DISCOVERY[item]:
			_add_src(src, r, "find %s" % _item_name(item))
	for prof: int in RecipeBook.PROFESSION:
		for r: StringName in RecipeBook.PROFESSION[prof]:
			_add_src(src, r, "recruit a %s" % PROFESSIONS[prof])
	for m: Dictionary in Tutorial.MISSIONS:
		for r in m.rewards.recipes:
			_add_src(src, StringName(r), "Wren: \"%s\"" % m.title)
	for r: StringName in RecipeBook.MERCHANT_SCROLLS:
		_add_src(src, r, "merchant scroll")
	for r: StringName in RecipeBook.REWARD_ONLY:
		if not src.has(r):
			_add_src(src, r, "quest reward / scroll")
	return src


static func _add_src(src: Dictionary, r: StringName, how: String) -> void:
	if not src.has(r):
		src[r] = []
	if not (src[r] as Array).has(how):
		src[r].append(how)


func _recipes() -> String:
	var src := _unlock_sources()
	var out := "# Recipes\n\nEvery recipe, by station. **Known from the start** unless an unlock is listed: then you learn it by finding the ingredient, recruiting a villager, finishing one of Wren's lessons, or reading a recipe scroll.\n\n"
	var by_cat := {}
	for r: RecipeDef in RecipeDB.get_all_recipes():
		if not by_cat.has(r.category):
			by_cat[r.category] = []
		by_cat[r.category].append(r)
	for cat in range(RECIPE_CATS.size()):
		if not by_cat.has(cat):
			continue
		var list: Array = by_cat[cat]
		list.sort_custom(func(a: RecipeDef, b: RecipeDef) -> bool: return a.name < b.name)
		var rows := []
		for r: RecipeDef in list:
			var ins := PackedStringArray()
			for i: Dictionary in r.inputs:
				ins.append("%d %s" % [int(i.count), _item_name(StringName(i.item_id))])
			var station := "anywhere" if r.required_station == &"none" else String(r.required_station).capitalize()
			var unlock := "known" if not RecipeBook.is_lockable(r.id) else "; ".join(PackedStringArray(src.get(r.id, ["locked"])))
			rows.append([r.name, ", ".join(ins), "%d %s" % [r.output_count, _item_name(r.output_item_id)], station,
				("%.0f s" % r.craft_time_sec) if r.craft_time_sec > 0.0 else "instant", unlock])
		out += "## %s (%d)\n\n" % [RECIPE_CATS[cat], list.size()]
		out += _table(["Recipe", "Ingredients", "Makes", "Station", "Time", "Unlock"], rows)
	return out


# ---------------------------------------------------------------- fish

func _fish() -> String:
	var list: Array = FishDB.get_all_fish()
	list.sort_custom(func(a: FishDef, b: FishDef) -> bool: return a.rarity < b.rarity or (a.rarity == b.rarity and a.name < b.name))
	var rows := []
	for f: FishDef in list:
		rows.append([f.name, RARITY[f.rarity], HABITAT[f.habitat], TIDE[f.tide_pref], TIME[f.time_pref],
			WEATHER[f.weather_pref], TACKLE[clampi(f.tackle_tier, 1, 4)], "%.1f-%.1f kg" % [f.min_weight_kg, f.max_weight_kg],
			"%.0f s / %.0f%%" % [f.base_stamina, f.pull_strength * 100.0]])
	return "# Fish\n\nWhat bites where and when. *Fight* is how long the fish thrashes and how hard it pulls.\n\n" \
		+ _table(["Fish", "Rarity", "Habitat", "Tide", "Time", "Weather", "Rod needed", "Weight", "Fight"], rows)


# ---------------------------------------------------------------- crops

func _crops() -> String:
	var rows := []
	var ids: Array = CropDB._registry.keys()
	ids.sort()
	for id in ids:
		var c: CropDef = CropDB._registry[id]
		rows.append([c.name, _item_name(c.seed_item_id), _item_name(c.harvest_item_id), SOIL[c.preferred_soil],
			"%.0f-%.0f%%" % [c.min_salinity * 100.0, c.max_salinity * 100.0], "%.0f s" % c.growth_duration_sec,
			"%d-%d" % [c.min_yield, c.max_yield], "yes" if c.can_regrow else "no"])
	return "# Crops\n\nSalinity is how salty the soil can be (tidal mud near the sea is saltier). Regrowing crops go back to a young plant after harvest.\n\n" \
		+ _table(["Crop", "Seed", "Harvest", "Soil", "Salinity", "Grows in", "Yield", "Regrows"], rows)


# ---------------------------------------------------------------- placeables

func _placeables() -> String:
	var rows := []
	for type: StringName in Placeables.blueprint_types():
		var cost := Placeables.build_cost(type)
		var parts := PackedStringArray()
		for item: StringName in cost:
			parts.append("%d %s" % [int(cost[item]), _item_name(item)])
		var rule: StringName = EntityManager.get_type_def(type).get("rule", &"ground")
		rows.append([_item_name(type), ", ".join(parts), {&"ground": "on the ground", &"intertidal": "between the tide lines", &"soil": "on soil"}.get(rule, String(rule))])
	var prefabs := []
	for p: Dictionary in Prefabs.all():
		prefabs.append([p.name, "%d x %d x %d" % [p.size.x, p.size.y, p.size.z]])
	return "# Furniture & Placeables\n\nBuild these with the Blueprints tool (pays the cost from your pack) or craft them at a workbench and place the item.\n\n" \
		+ _table(["Placeable", "Cost", "Where"], rows) \
		+ "## Voxel blueprints\n\nPrefab structures placed with the Blueprints tool. Size is in voxels (0.18 m).\n\n" \
		+ _table(["Blueprint", "Size"], prefabs)


# ---------------------------------------------------------------- creatures

const CREATURE_INFO := {
	&"crab": ["Tide-crab", "Intertidal flats at low tide", "Never on Cozy, and only when cornered"],
	&"gull": ["Gull", "Shores and docks by day", "Steals a held raw fish if you stand still (not on Cozy)"],
	&"eel": ["Cave eel", "Flooded sea cave after dark (any time on Undertow)", "Yes: lunges at the water's edge (never on Cozy)"],
	&"hare": ["Coastal hare", "Grassland, day and dusk", "No"],
	&"seal": ["Harbour seal", "Beach flats at low tide; shallows otherwise", "No"],
	&"puffin": ["Puffin", "Sea stacks and cliff tops by day", "No"],
	&"otter": ["Sea otter", "Kelp beds and calm water near shore", "No (can be befriended)"],
	&"heron": ["Grey heron", "The shallows, dawn to dusk", "No"],
	&"whale": ["Humpback whale", "Deep water far offshore, by day (rare)", "No"],
	&"fox": ["Red fox", "Woods by day (den); raids pens at night", "Never hurts players; takes ducks, eggs or feed"],
	&"stoat": ["Stoat", "Woods; raids coops at night", "Never hurts players; steals eggs"],
	&"rat": ["Shore rat", "Up from the tideline the nights after a storm", "Never hurts players; eats food from open chests and crates"],
	&"eagle": ["Sea eagle", "High over the island by day", "Never hurts players; stoops on ducks in the open (scatters them on Cozy)"],
}


func _creatures() -> String:
	var net := Node.new()
	var rows := []
	for kind: StringName in CreatureNet.KINDS:
		var c: Creature = _make_creature(kind)
		if c == null:
			continue
		var info: Array = CREATURE_INFO.get(kind, [String(kind).capitalize(), "", ""])
		rows.append([info[0], info[1], info[2], ("%.0f HP" % c.max_hp) if c.damageable else "can't be harmed", c.hint()])
		c.free()
	net.free()
	return "# Creatures & Wildlife\n\nToughness is the base HP (x1.5 on Undertow). Every threat has a non-combat answer: see *How to deal with it*.\n\n" \
		+ _table(["Creature", "Where & when", "Dangerous?", "Toughness", "How to deal with it"], rows)


static func _make_creature(kind: StringName) -> Creature:
	match kind:
		&"crab": return TideCrab.new()
		&"gull": return Gull.new()
		&"eel": return CaveEel.new()
		&"hare": return CoastalHare.new()
		&"seal": return HarbourSeal.new()
		&"puffin": return Puffin.new()
		&"otter": return SeaOtter.new()
		&"heron": return GreyHeron.new()
		&"whale": return MigratingWhale.new()
		&"fox": return RedFox.new()
		&"stoat": return Stoat.new()
		&"rat": return ShoreRat.new()
		&"eagle": return SeaEagle.new()
	return null
